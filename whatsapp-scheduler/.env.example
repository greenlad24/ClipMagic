# ---------------------------------------------------------------------------
# WhatsApp Cloud Scheduler — environment configuration
# Copy this file to `.env` and edit the values, then run `npm start`.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on.
PORT=3000

# Host/interface to bind to. 0.0.0.0 listens on all interfaces (needed in Docker
# and when exposing the app on a server); use 127.0.0.1 to keep it local-only.
HOST=0.0.0.0

# Server timezone. ALL wall-clock scheduling (e.g. "monday 9am") is interpreted
# in this timezone. Use an IANA name, e.g. Europe/London, America/New_York.
TZ=Europe/London

# Directory where scheduled messages (messages.json) and the personal-provider
# WhatsApp session (wwebjs_auth) are stored. Relative to the app root.
DATA_DIR=./data

# Which send back-end to use:
#   personal → whatsapp-web.js, a QR-linked device (message anyone, free text).
#              WARNING: automating a PERSONAL number violates WhatsApp's Terms
#              and can get the number banned. Use a dedicated/secondary number
#              and keep volume low.
#   business → official WhatsApp Business Cloud API (token-based, requires the
#              three WA_* business vars below).
WA_PROVIDER=personal

# Optional: path to a Chromium/Chrome binary for the personal provider's headless
# browser. Leave unset to use the bundled Puppeteer Chromium. In Docker this is
# set to /usr/bin/chromium by the image.
# WA_CHROME_PATH=/usr/bin/chromium

# Optional: bearer token that protects the /api/* routes. STRONGLY recommended
# whenever the port is reachable on a public IP. When set, every API request
# must send `Authorization: Bearer <token>`; the web app will prompt for it.
# API_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Business provider only (WA_PROVIDER=business) — from Meta / Facebook Developers
# ---------------------------------------------------------------------------

# The Phone Number ID of your WhatsApp Business sender.
# WA_PHONE_NUMBER_ID=

# A permanent (or long-lived) system-user access token with whatsapp permissions.
# WA_ACCESS_TOKEN=

# Graph API version to call.
WA_API_VERSION=v21.0
