{
  "about": "HARD RULES IN THE CLICK CODE (architecture recommendation 3.7, RULEBOOK L4/R10). Read by screencast/clickguard.mjs (every recorder) and aieditor/clickguard.py (replays, plan checks). A refusal is a beat failure and is never retried with the same action. Labels match case-insensitively on word boundaries; a space in a phrase also matches '-', '_' or nothing ('log out' = 'Log-out' = 'logout'). allow_labels are phrases taken out before the deny check ('Remove background' is a feature; removing an unsent composer attachment is harmless).",
  "version": 1,
  "deny_labels": [
    "delete",
    "remove",
    "buy",
    "purchase",
    "upgrade",
    "subscribe",
    "checkout",
    "check out",
    "pay",
    "publish",
    "share",
    "invite",
    "billing",
    "manage subscription",
    "cancel plan",
    "add account",
    "log out",
    "sign out"
  ],
  "allow_labels": [
    "remove background",
    "remove bg",
    "background remover",
    "remove file",
    "remove attachment"
  ],
  "outside_deny_labels": [
    "log in",
    "sign in",
    "sign up",
    "create account",
    "register",
    "get started",
    "start free trial",
    "try for free"
  ],
  "deny_urls_logged_in": [
    "/pricing",
    "#pricing",
    "/billing",
    "/settings/billing",
    "/account/billing",
    "/checkout",
    "/upgrade",
    "/logout",
    "/signout",
    "/sign-out",
    "/log-out",
    "/auth/logout",
    "#settings/billing",
    "/plans"
  ],
  "deny_urls_outside": [
    "/login",
    "/log-in",
    "/signin",
    "/sign-in",
    "/signup",
    "/sign-up",
    "/register",
    "/auth/login",
    "/auth/signup",
    "/checkout",
    "/billing",
    "/subscribe",
    "/buy",
    "/purchase",
    "/logout",
    "/signout",
    "/auth/logout"
  ],
  "deny_hosts": [
    "checkout.stripe.com",
    "billing.stripe.com",
    "pay.openai.com",
    "auth.openai.com",
    "accounts.google.com"
  ],
  "payment_input": [
    "cc-number",
    "cc-csc",
    "cc-exp",
    "cc-exp-month",
    "cc-exp-year",
    "cc-name",
    "cardnumber",
    "card-number",
    "card number",
    "cvc",
    "cvv",
    "security code",
    "iban",
    "expiry",
    "expiration",
