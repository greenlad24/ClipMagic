    "title",
    "testid",
    "name",
    "value",
    "role",
    "alt"
  ],
  "max_text_len": 80,
  "forbidden_action_words": [
    "logout",
    "log out",
    "log_out",
    "signout",
    "sign out",
    "sign_out"
  ],
  "guarded": {
    "click": "target",
    "dblclick": "target",
    "key": "focused",
    "goto": "url",
    "open": "url",
    "reload": "url",
    "type": "payment"
  }
}
