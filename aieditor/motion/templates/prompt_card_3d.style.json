 "neutral": {
  "app": "neutral",
  "theme": "light",
  "model": "Pro",
  "composer": {
   "width": 1034,
   "height": 270,
   "placeholder": "Ask anything…",
   "prompt_sel": ".nb-prompt",
   "send_sel": ".nb-send",
   "text_sel": ".nb-text",
   "caret_html": "<span class=\"nb-caret\"></span>",
   "css": "\n.nb-card{position:relative;box-sizing:border-box;width:1034px;padding:43px 36px 34px 44px;font-family:Inter,sans-serif;color:#2e2b2e;-webkit-font-smoothing:antialiased}\n.nb-card.has-chips{padding-top:25px}\n.nb-chips{display:grid;grid-template-columns:408px 408px;column-gap:21px;row-gap:18px;margin:0 0 10px 0}\n.nb-chips:empty{display:none}\n.nb-text{position:relative;margin-left:1px;width:860px;min-height:78px;font-size:30px;line-height:39px;letter-spacing:0.029em;font-weight:400;white-space:pre-wrap;word-wrap:break-word}\n.nb-ph{color:#3a373a}\n.nb-prompt:not(:empty)~.nb-ph{display:none}\n.nb-state:empty{display:none}\n.nb-foot{display:flex;align-items:center;height:71px;margin:46px 0 0 -12px}\n.nb-btn{box-sizing:border-box;width:71px;height:71px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#4a474a;border:1.5px solid rgba(255,255,255,.75);box-shadow:inset 0 0 0 1px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.06);margin-right:11px}\n.nb-pill{box-sizing:border-box;height:67px;display:flex;align-items:center;gap:19px;padding:0 27px 0 22px;border-radius:34px;border:1.5px solid rgba(255,255,255,.75);box-shadow:inset 0 0 0 1px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.06);color:#3b383b;font-size:29px;letter-spacing:0.02em}\n.nb-pill svg{color:#3b383b}\n.nb-sp{flex:1}\n.nb-model{display:flex;align-items:center;gap:12px;color:#8d898c;font-size:29px;letter-spacing:0.02em;margin-right:40px}\n.nb-model svg{color:#8d898c}\n.nb-send{position:relative;width:68px;height:68px;border-radius:50%;background:radial-gradient(circle at 40% 30%,#6e5038 0%,#5a3f2b 60%,#4d3524 100%);box-shadow:0 3px 6px rgba(60,40,25,.35),inset 0 1px 1px rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center}\n.nb-send>span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}\n.nb-caret{display:inline-block;width:2px;height:33px;margin-left:1px;vertical-align:-7px;background:#2e2b2e}\n",
   "html": "<div class=\"nb-card {{layout_class}}\"><div class=\"nb-chips\">{{chips_html}}</div><div class=\"nb-text\"><span class=\"nb-prompt\">{{prompt}}</span>{{caret_html}}<span class=\"nb-ph\">{{placeholder}}</span></div><div class=\"nb-state\">{{state_html}}</div><div class=\"nb-foot\"><span class=\"nb-btn\"><svg viewBox=\"0 0 24 24\" width=\"34\" height=\"34\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 4v16M4 12h16\"/></svg></span><span class=\"nb-btn\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.5 3.5l6 3.5-3 5.2-6-3.5z\"/><path d=\"M14.5 11.8l3 1.7-3.4 6-6-3.5 1.5-2.6\"/></svg></span><span class=\"nb-pill\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2.5v3.2M12 18.3v3.2M2.5 12h3.2M18.3 12h3.2M5.3 5.3l2.2 2.2M16.5 16.5l2.2 2.2M5.3 18.7l2.2-2.2M16.5 7.5l2.2-2.2\"/><path d=\"M10 10l9.5 9.5\" stroke-width=\"2\"/></svg><span>Create</span></span><span class=\"nb-sp\"></span><span class=\"nb-model\">{{model}}<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg></span><span class=\"nb-send\"><span class=\"nb-mic\"><svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"#fff\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"12\" rx=\"3\"/><path d=\"M6 11.5a6 6 0 0 0 12 0\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><path d=\"M12 17.5V21M9 21h6\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span><span class=\"nb-arrow\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5.5 11.5L12 5l6.5 6.5\"/></svg></span></span></div></div>"
  },
  "chip": {
   "css": "\n.nb-chip{position:relative;box-sizing:border-box;width:408px;height:75px;display:flex;align-items:center;gap:16px;padding:0 0 0 21px;border-radius:18px;background:rgba(255,255,255,.10);border:1.5px solid rgba(255,255,255,.72);box-shadow:inset 0 0 0 1px rgba(0,0,0,.035),0 2px 6px rgba(0,0,0,.04)}\n.nb-chip-ic{flex:none;width:34px;height:44px}\n.nb-chip-name{font-size:26px;line-height:26px;letter-spacing:0.012em;color:#2e2b2e;white-space:pre-line;max-width:332px}\n",
   "html": "<span class=\"nb-chip nb-chip--{{kind}}\"><span class=\"nb-chip-ic\">{{icon_html}}</span><span class=\"nb-chip-name\">{{name}}</span></span>",
   "icons": {
    "doc": "<svg viewBox=\"0 0 34 44\" width=\"34\" height=\"44\"><path d=\"M2 3a3 3 0 0 1 3-3h17l10 10v31a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z\" fill=\"#fff\" stroke=\"rgba(0,0,0,.08)\"/><path d=\"M22 0v7a3 3 0 0 0 3 3h7\" fill=\"#eceaea\"/><text x=\"16\" y=\"25\" font-family=\"Inter\" font-weight=\"700\" font-size=\"15\" fill=\"#2b7cd3\" text-anchor=\"middle\">W</text><text x=\"16\" y=\"38\" font-family=\"Inter\" font-size=\"5.2\" fill=\"#555\" text-anchor=\"middle\" letter-spacing=\".3\">DOC</text></svg>",
    "pdf": "<svg viewBox=\"0 0 34 44\" width=\"34\" height=\"44\"><path d=\"M2 3a3 3 0 0 1 3-3h17l10 10v31a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z\" fill=\"#fff\" stroke=\"rgba(0,0,0,.08)\"/><path d=\"M22 0v7a3 3 0 0 0 3 3h7\" fill=\"#eceaea\"/><path d=\"M16 11c-1.3 0-1 3 .6 6.5 1.3 2.8 3.5 5.4 6.3 6.3 1.8.6 2.4-.6 1.1-1.3-2.6-1.4-8.8-.3-12.3 1.9-1.9 1.2-1.4 2.6.3 1.7 2.3-1.3 4.3-6 5-9.8.4-2.3.1-5.3-1-5.3z\" fill=\"none\" stroke=\"#e0242f\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><text x=\"16\" y=\"38\" font-family=\"Inter\" font-size=\"5.2\" fill=\"#555\" text-anchor=\"middle\" letter-spacing=\".3\">PDF</text></svg>",
    "xlsx": "<svg viewBox=\"0 0 34 44\" width=\"34\" height=\"44\"><path d=\"M2 3a3 3 0 0 1 3-3h17l10 10v31a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z\" fill=\"#fff\" stroke=\"rgba(0,0,0,.08)\"/><path d=\"M22 0v7a3 3 0 0 0 3 3h7\" fill=\"#eceaea\"/><text x=\"16\" y=\"25\" font-family=\"Inter\" font-weight=\"700\" font-size=\"15\" fill=\"#2fbf5b\" text-anchor=\"middle\">X</text><text x=\"16\" y=\"38\" font-family=\"Inter\" font-size=\"5.2\" fill=\"#555\" text-anchor=\"middle\" letter-spacing=\".3\">XLS</text></svg>",
    "image": "<svg viewBox=\"0 0 34 44\" width=\"34\" height=\"44\"><path d=\"M2 3a3 3 0 0 1 3-3h17l10 10v31a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z\" fill=\"#fff\" stroke=\"rgba(0,0,0,.08)\"/><path d=\"M22 0v7a3 3 0 0 0 3 3h7\" fill=\"#eceaea\"/><rect x=\"8\" y=\"12\" width=\"17\" height=\"13\" rx=\"2\" fill=\"none\" stroke=\"#7a5af8\" stroke-width=\"1.7\"/><circle cx=\"13\" cy=\"16.5\" r=\"1.6\" fill=\"#7a5af8\"/><path d=\"M9 24l5-5 4 4 2.5-2.5L24 24\" fill=\"none\" stroke=\"#7a5af8\" stroke-width=\"1.6\"/><text x=\"16\" y=\"38\" font-family=\"Inter\" font-size=\"5.2\" fill=\"#555\" text-anchor=\"middle\" letter-spacing=\".3\">IMG</text></svg>",
    "other": "<svg viewBox=\"0 0 34 44\" width=\"34\" height=\"44\"><path d=\"M2 3a3 3 0 0 1 3-3h17l10 10v31a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3z\" fill=\"#fff\" stroke=\"rgba(0,0,0,.08)\"/><path d=\"M22 0v7a3 3 0 0 0 3 3h7\" fill=\"#eceaea\"/><path d=\"M9 15h15M9 19h15M9 23h10\" stroke=\"#888\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><text x=\"16\" y=\"38\" font-family=\"Inter\" font-size=\"5.2\" fill=\"#555\" text-anchor=\"middle\" letter-spacing=\".3\">FILE</text></svg>"
   }
  },
  "working": {
   "css": "\n.nb-thread{display:flex;flex-direction:column;margin-top:17px}\n.nb-user{display:flex;justify-content:flex-end;align-items:flex-start;gap:10px;margin-right:-10px}\n.nb-bubble{box-sizing:border-box;max-width:744px;padding:14px 12px 13px 20px;border-radius:16px;background:rgba(40,30,35,.065);font-size:26px;line-height:34px;letter-spacing:0.03em;color:#3d3a3d;text-align:right;white-space:pre-wrap}\n.nb-av{flex:none;margin-top:6px}\n.nb-working{display:flex;align-items:center;gap:18px;height:40px;margin:25px 0 5px 6px;color:#7a777a;font-size:31px;letter-spacing:0.02em}\n",
   "html": "<div class=\"nb-working\"><span class=\"nb-spin\"><svg viewBox=\"0 0 24 24\" width=\"32\" height=\"32\" fill=\"#4a474a\"><circle cx=\"12.00\" cy=\"4.00\" r=\"2\" opacity=\"1\"/><circle cx=\"18.93\" cy=\"8.00\" r=\"2\" opacity=\"0.85\"/><circle cx=\"18.93\" cy=\"16.00\" r=\"2\" opacity=\"0.7\"/><circle cx=\"12.00\" cy=\"20.00\" r=\"2\" opacity=\"0.55\"/><circle cx=\"5.07\" cy=\"16.00\" r=\"2\" opacity=\"0.4\"/><circle cx=\"5.07\" cy=\"8.00\" r=\"2\" opacity=\"0.25\"/></svg></span><span class=\"nb-wtext\">{{text}}</span></div>"
  },
  "bubble": {
   "html": "<div class=\"nb-user\"><div class=\"nb-bubble\">{{text}}</div><span class=\"nb-av\"><svg viewBox=\"0 0 24 24\" width=\"38\" height=\"38\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#8f8a8d\"/><circle cx=\"12\" cy=\"9.3\" r=\"3.9\" fill=\"#ece9ea\"/><path d=\"M4.8 19.2c1.6-3 4.2-4.3 7.2-4.3s5.6 1.3 7.2 4.3\" fill=\"#ece9ea\"/></svg></span></div>"
  },
  "result": {
   "image": {
    "css": "\n.nb-result{box-sizing:border-box;width:1034px;padding:34px;font-family:Inter,sans-serif;color:#2e2b2e;-webkit-font-smoothing:antialiased}\n.nb-result img{display:block;width:100%;height:auto;border-radius:24px}\n.nb-rtext{font-size:28px;line-height:40px;letter-spacing:0.02em;white-space:pre-line}\n",
    "html": "<div class=\"nb-result\"><img src=\"{{src}}\" alt=\"{{alt}}\"></div>"
   },
   "text": {
    "css": "\n.nb-result{box-sizing:border-box;width:1034px;padding:34px;font-family:Inter,sans-serif;color:#2e2b2e;-webkit-font-smoothing:antialiased}\n.nb-result img{display:block;width:100%;height:auto;border-radius:24px}\n.nb-rtext{font-size:28px;line-height:40px;letter-spacing:0.02em;white-space:pre-line}\n",
    "html": "<div class=\"nb-result\"><div class=\"nb-rtext\">{{text_html}}</div></div>"
   }
  }
 },
