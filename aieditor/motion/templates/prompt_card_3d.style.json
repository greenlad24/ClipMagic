  "rim_top": "rgba(30,24,22,0.85)",
  "rim_left": "rgba(45,40,40,0.35)",
  "rim_px": 2.6,
  "rim_mask": "linear-gradient(90deg, #000 0%, rgba(0,0,0,0.75) 30%, rgba(0,0,0,0.25) 60%, transparent 85%)",
  "inner_highlight": "inset 0 -2px 1px rgba(255,255,255,0.85), inset -2px 0 1px rgba(255,255,255,0.6)",
  "shadow": "0 34px 70px rgba(70,62,70,0.16), 0 10px 22px rgba(70,62,70,0.10)",
  "tile_bg": "rgba(255,255,255,0.62)",
  "tile_border": "rgba(255,255,255,0.95)",
  "tile_bg_dark": "rgba(255,255,255,0.16)"
 },
 "type": {
  "family": "Inter",
  "weight": 400,
  "size_px": 30,
  "size_frac_h": 0.0278,
  "line_px": 39,
  "tracking_em": 0.029,
  "color": "#2e2b2e",
  "placeholder_color": "#3a373a",
