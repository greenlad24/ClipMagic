  "plate": "data:image/png;base64,",
  "plate_note": "the reference's static grey plate with soft light streaks, 96x54 PNG from motion4 f60 (card hole inpainted), scaled with smoothing; it does NOT move (measured: 0 px shift f12..f222)",
  "color": "#d3d0d4",
  "kit_mix": {
   "opacity": 0.1,
   "blend": "soft-light"
  }
 },
