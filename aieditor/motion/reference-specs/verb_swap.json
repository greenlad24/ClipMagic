   ]
  },
  "verb_in": {
   "_doc": "verb_0 and the suffix pop in together on beat verb_0, right of their slots, and slide left into place; the suffix travels ~1.6x the verb. Prefix does not move (the line is laid out for verb_0 from the first frame). [max err 1.35 px]",
   "rel": "verb_0",
   "start_s": -0.033,
   "dur_s": 0.38,
   "verb_dx_em": 0.29,
   "suffix_dx_em": 0.462,
