#!/usr/bin/env python3
"""aieditor-worker — runs Auto Editor jobs for the Lab (systemd: aieditor-worker.service).

The Lab is the CONTROL PLANE (lab/server/src/aieditor/control.ts): it writes a job
directory and reads files back. This service, on the HOST, does all media work —
it shells out to Docker for ffmpeg and the aligner, and a 46-minute job must outlive
the browser tab and a Lab rebuild. One job at a time.

LAYOUT (the filesystem is the database) — /opt/aieditor-work/jobs/<id>/
  request.json      what Jake asked for (Lab writes): source, format, sponsored, script
                    source = {"kind": "descript", url} | {"kind": "job", job, file} (a finished
                    Lab edit) | {"kind": "upload", upload, name} (jobs/_uploads/<id>/, from the
                    Lab's chunked upload) — the last two are hard-linked in: aieditor/sources.py
  queue.json        {"action": "run" | "rebuild" | "recut" | "render"} (Lab writes, worker
                    claims + deletes). run = the whole pipeline (video preview at the end);
                    rebuild/recut = new cut + sound check only, the video is NOT re-rendered
                    (Jake: "instead of rerender"); render = the video preview of the current cut
  cancel            stop now (Lab writes)
  status.json       state, stage, progress, message, per-stage timings, cost (worker)
  source.mp4        the raw video          audio16k.wav / .mp3, full48k.wav
  words.json        Groq transcript        aligned.json   forced-aligned times
  plan.raw.json     Claude's answer        plan.json      validated plan (what is kept)
  plan.edit.json    Jake's edits from the review screen (Lab writes; wins over plan.json)
  joins.edit.json   Jake's hand nudges of single cuts, {"nudges": {"a:<word id>": ms, "b:<word id>": ms}}
  review.json       sentences + plan + reasons, for the review screen
  edl.json          frame-exact pieces + output-timeline words per video
  listen-NN.mp4     sound check: the exact soundtrack over the first frame, held (~3 min for 23 min)
  preview-NN.mp4    1080p review renders
  graphics-NN.json  phase 2 (shorts): Claude's graphics plan per video — events anchored to word ids
  gfx-NN/           the events' frames (motion/render.mjs, measured recipes)
  captions-NN.ass   word-by-word captions (the Lab's own caption engine)
  edit-NN.mp4       the preview + graphics + captions + SFX
  final-NN.mp4      queue action "final": shorts = full-resolution cut + 2× graphics + captions + SFX;
                    long-form = the full edit at source resolution when one exists, else the cut alone
  edit-NN/          long-form full edit: direct.json (plan), seg-SS/ (inventory, script, rec/), gfx/,
                    overlays.json — longedit.py; request.json "sites" = [{url, note}] to screencast
  log.txt           what happened (plain text, kept for humans)
  events.jsonl      the SAME story, structured, one JSON object per line (aieditor/events.py):
                    {t, stage, kind: log|progress|api|proc|step|stage, level, msg, sub, …} — the Lab's
                    per-stage live log. Sub-processes (renders, recorder, aligner) and every paid
                    API call (model + $) report here; status.json stages[*] carry progress,
                    message, cost_usd, api_calls, warnings, errors for the progress bars

WORKFLOWS (request.json "workflow", Jake 2026-10-08: "there are 2 workflows"):
  cut       1. Cut an unedited narration (the default; jobs from before have no field):
            download → audio → transcribe → align → takes → cut → listen → graphics/preview → compose
  creative  2. Creative Edit an edited narration: the narration is already edited, so takes/cut
            are skipped and the whole timeline is kept as-is (edl.passthrough):
            download → audio → transcribe → align → timeline → preprod → graphics/preview → compose
            "preprod" = PRE-PRODUCTION, stage 0 of the creative edit — aieditor/preprod.py, built
            separately (sandbox: /opt/aieditor-work/loop/aieditor/aieditor/preprod.py). The worker
            calls it when the module exists and skips the stage otherwise (see run_preprod).
"""
import importlib
import inspect
import json
import os
import shutil
import signal
import sys
import threading
import time
import traceback
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from aieditor import align, camera, cloud, compose, config, descript, edl, events, graphics, longedit, media, render, sources, takes, transcribe, wordiff  # noqa: E402
from aieditor import sites as sites_mod  # noqa: E402

STAGES = ["download", "audio", "transcribe", "align", "takes", "cut", "listen", "graphics", "preview", "compose"]
# workflow 2: no takes / cut / sound check — the edited timeline is kept, then pre-production
CREATIVE_STAGES = ["download", "audio", "transcribe", "align", "timeline", "preprod", "graphics", "preview", "compose"]


def workflow_of(req):
    return "creative" if (req or {}).get("workflow") == "creative" else "cut"


def stages_for(req):
    return CREATIVE_STAGES if workflow_of(req) == "creative" else STAGES
STOP = False


class Cancelled(Exception):
    pass


def now():
    return time.time()


def jdump(path, obj):
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(json.dumps(obj, indent=1))
    os.replace(tmp, path)


def jload(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


class Job:
    def __init__(self, d):
        self.d = Path(d)
        self.id = self.d.name
        self.req = jload(self.d / "request.json", {})
        self.st = jload(self.d / "status.json", {}) or {}
        self.st.setdefault("stages", {})
        for s in stages_for(self.req):
            self.st["stages"].setdefault(s, {"state": "pending"})
        self.st.setdefault("cost_usd", 0.0)
        self.st["workflow"] = workflow_of(self.req)
        self.cur = None                 # the running stage: events are filed under it
        self._last_msg = None

    # ── the structured event log (events.jsonl) — aieditor/events.py's sink ──
    def event(self, ev):
        ev.setdefault("stage", self.cur or "job")
        with open(self.d / "events.jsonl", "a") as f:
            f.write(json.dumps(ev, ensure_ascii=False) + "\n")
        s = self.st["stages"].get(self.cur) if self.cur else None
        if s is not None:
            if ev.get("level") == "warn":
                s["warnings"] = s.get("warnings", 0) + 1
            elif ev.get("level") == "error":
                s["errors"] = s.get("errors", 0) + 1
            if ev.get("kind") == "api":
                s["api_calls"] = s.get("api_calls", 0) + 1
                if ev.get("usd"):
                    s["api_usd"] = round(s.get("api_usd", 0.0) + ev["usd"], 5)
                    self.save()                               # the live cost moves now

    def log(self, msg):
        with open(self.d / "log.txt", "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
        if not (msg.startswith("stage ") and msg.split(" ")[2:3] in (["start"], ["done"])):
            events.emit("log", msg, level=events.level_of(msg))     # (stage start/done: a "stage" event says it)

    def save(self, **kw):
        self.st.update(kw)
        self.st["updated_at"] = now()
        # cost so far INCLUDING the running stage's API calls (most stages add their
        # total to cost_usd only when they finish)
        live = self.st.get("cost_usd", 0.0)
        s = self.st["stages"].get(self.cur) if self.cur else None
        if s and s.get("state") == "running":
            added = live - s.get("cost_at_start", live)
            live += max(0.0, s.get("api_usd", 0.0) - added)
            s["cost_usd"] = round(max(added, s.get("api_usd", 0.0)), 4)
        self.st["cost_live_usd"] = round(live, 4)
        jdump(self.d / "status.json", self.st)

    def stage(self, name, state, note=None):
        s = self.st["stages"].setdefault(name, {})
        prev = s.get("state")
        s["state"] = state
        if state == "running":
            s["started_at"] = now()
            for k in ("finished_at", "note", "message", "api_usd", "api_calls", "warnings", "errors", "cost_usd"):
                s.pop(k, None)
            s["progress"] = 0
            s["cost_at_start"] = self.st.get("cost_usd", 0.0)
            self.cur = name
            self._last_msg = None
            events.set_sub(None)
        if state in ("done", "failed", "skipped", "interrupted"):
            s["finished_at"] = now()
            if note == "reused" and prev != "running":
                s.pop("started_at", None)                    # nothing ran: no elapsed time
            if prev == "running":
                added = self.st.get("cost_usd", 0.0) - s.get("cost_at_start", self.st.get("cost_usd", 0.0))
                s["cost_usd"] = round(max(added, s.get("api_usd", 0.0)), 4)
            if state == "done":
                s["progress"] = 1
        if note is not None:
            s["note"] = note
        if state == "running":
            events.emit("stage", f"▶ {name} started", stage=name, state=state)
        else:
            took = (s["finished_at"] - s["started_at"]) if s.get("started_at") and s.get("finished_at") else None
            events.emit("stage", f"{'✓' if state == 'done' else '■'} {name} {state}"
                        + (f" in {took:.1f}s" if took is not None and prev == "running" else "")
                        + (f" — {note}" if note else ""), stage=name, state=state,
                        level="error" if state == "failed" else "warn" if state == "interrupted" else "info")
        if state != "running" and self.cur == name:
            self.cur = None
        self.save(stage=name if state == "running" else self.st.get("stage"))

    def progress(self, msg=None, frac=None):
        if self.cancelled():
            raise Cancelled()
        kw = {}
        if msg is not None:
            kw["message"] = msg
        if frac is not None:
            kw["progress"] = round(frac, 3)
        s = self.st["stages"].get(self.cur) if self.cur else None
        if s is not None:
            if msg is not None:
                s["message"] = msg
            if frac is not None:
                s["progress"] = round(max(0.0, min(1.0, frac)), 3)
        if msg is not None and msg != self._last_msg:
            self._last_msg = msg
            events.emit("progress", msg, frac=round(frac, 3) if frac is not None else None)
        self.save(**kw)

    def cancelled(self):
        return STOP or (self.d / "cancel").exists()


def run_job(job, action):
    d = job.d
    req = job.req
    fmt = req.get("format")
    sponsored = req.get("sponsored")
    if fmt not in ("short", "long") or sponsored not in (True, False):
        raise RuntimeError("request.json needs format short|long and sponsored true|false")

    def step(name, fn, done_if=None, rerun=False):
        if not rerun and done_if is not None and done_if():
            if job.st["stages"].get(name, {}).get("state") != "done":
                job.stage(name, "done", "reused")
            return
        job.stage(name, "running")
        job.progress(None, 0)
        job.log(f"stage {name} start")
        note = fn()
        job.log(f"stage {name} done {note or ''}")
        job.stage(name, "done", note)

    rebuild = action in ("rebuild", "recut")
    creative = workflow_of(req) == "creative"

    if action == "final":
        return run_final(job, fmt)

    # 1 download (a Descript link) — or a Lab edit / an uploaded file already on this volume:
    # hard-linked into the job as source.mp4 (aieditor/sources.py; for a factory job that
    # happens on the main box before the folder is sent: execute_cloud)
    def do_download():
        if sources.kind_of(req) != "descript":
            return sources.prepare(d, req, config.JOBS, media.probe,
                                   progress=lambda m, f=None: job.progress(m, f))
        src = req.get("source", {})
        facts = descript.download(src.get("url"), d / "source.part",
                                  progress=lambda m, f=None: job.progress(m, f),
                                  cancelled=job.cancelled)
        os.replace(d / "source.part", d / "source.mp4")
        info = media.probe(d / "source.mp4")
        jdump(d / "source.json", {**facts, **info})
        return f"{info['width']}x{info['height']}, {info['duration'] / 60:.1f} min"
    step("download", do_download, lambda: (d / "source.mp4").exists() and (d / "source.json").exists())
    info = jload(d / "source.json")
    fps = info["fps"]

    # 2 audio
    step("audio", lambda: media.extract_audio(d / "source.mp4", d) or "16 kHz + 48 kHz PCM",
         lambda: all((d / f).exists() for f in ("audio16k.wav", "audio16k.mp3", "full48k.wav")))

    # 3 transcribe
    def do_transcribe():
        job.progress("Transcribing with Groq Whisper…")
        doc = transcribe.transcribe(d / "audio16k.mp3", d / "words.json", wav16k=d / "audio16k.wav",
                                    job=d, audio=edl.Audio(d / "audio16k.wav"))
        usd = (doc.get("duration") or 0) / 3600 * 0.04
        job.st["cost_usd"] = round(job.st["cost_usd"] + usd, 4)
        events.api(config.GROQ_MODEL, usd, None, f"Groq Whisper transcription of {(doc.get('duration') or 0) / 60:.1f} min")
        fixed = [r for r in doc["repairs"] if "->" in r]
        for r in doc["repairs"]:
            job.log("transcript repair " + r)
        return f"{len(doc['words'])} words" + (f", {len(fixed)} skipped stretch(es) recovered" if fixed else "")
    step("transcribe", do_transcribe, lambda: (d / "words.json").exists())

    # 4 align
    def do_align():
        job.progress("Re-timing every word against the audio…")
        return align.align(d, progress=lambda a, b: job.progress(f"Re-timing words: {a}/{b} sentences", a / max(b, 1)))
    step("align", do_align, lambda: (d / "aligned.json").exists())

    words = takes.load_words(d / "words.json")
    sents = takes.sentences(words)                      # ids from Whisper's times
    aligned = jload(d / "aligned.json")["words"]
    for w in words:                                     # then swap in the aligned times
        w["s"], w["e"] = float(aligned[w["i"]]["start"]), float(aligned[w["i"]]["end"])
    by_id = {w["i"]: w for w in words}
    audio = edl.Audio(d / "audio16k.wav")
    # word-timing integrity (RULEBOOK §1 C1: word times drive every word-cued beat): a
    # hallucinated duplicate or an overlapping word is flagged in the log + wordcheck.json
    issues = wordiff.check_words(words)
    jdump(d / "wordcheck.json", {"issues": issues})
    for it in issues[:20]:
        job.log(f"warning: word timing {it['kind']} at {it['t0']:.2f}-{it['t1']:.2f}s: {it['text'][:80]}")
    if issues:
        job.log(f"warning: word timing: {sum(i['kind'] == 'duplicate' for i in issues)} duplicate run(s), "
                f"{sum(i['kind'] == 'overlap' for i in issues)} overlap(s)")

    if creative:
        # workflow 2: the narration is already edited — every sentence is kept, in order
        if not (d / "plan.json").exists():
            jdump(d / "plan.json", {
                "videos": [{"title": req.get("title") or "Video 1",
                            "segments": [{"s": n, "drop": []} for n in range(len(sents))]}],
                "removed": [],
                "notes": "Creative edit: the narration was already edited, so every word is kept — no cuts.",
            })
        plan = jload(d / "plan.json")
        jdump(d / "review.json", {
            "sentences": [{"s": n, "start": round(s[0]["s"], 2), "end": round(s[-1]["e"], 2),
                           "words": [{"i": w["i"], "w": w["w"]} for w in s]} for n, s in enumerate(sents)],
            "videos": plan["videos"], "reasons": {}, "notes": plan.get("notes", ""), "edited": False,
        })

        def do_timeline():
            # optional request.json "excerpt": [[t0, t1], ...] source seconds — a short test of the edit
            v = edl.passthrough(words, by_id, info["duration"], fps, plan["videos"][0]["title"],
                                excerpt=req.get("excerpt"))
            jdump(d / "edl.json", {"fps": fps, "fps_num": info["fps_num"], "fps_den": info["fps_den"],
                                   "width": info["width"], "height": info["height"], "videos": [v],
                                   "workflow": "creative"})
            if v.get("excerpt"):
                return (f"excerpt kept: {v['duration']:.0f}s of " + ", ".join(f"{a:.0f}–{b:.0f}s" for a, b in v["excerpt"])
                        + f", {len(v['words'])} words")
            return f"whole timeline kept: {v['duration']:.0f}s, {len(v['words'])} words, no cuts"
        step("timeline", do_timeline, lambda: (d / "edl.json").exists(), rerun=rebuild)
        if action in ("run", "edit"):
            run_preprod(job, req, info, fps)
    else:
        run_cut_path(job, action, req, fmt, sponsored, info, fps, words, sents, by_id, audio, step, rebuild)
        if rebuild and any(d.glob("preview-*.mp4")):
            return
    run_edit_part(job, action, req, fmt, sponsored, info, fps, audio, step)


def run_preprod(job, req, info, fps):
    """PRE-PRODUCTION — stage 0 of the creative edit (workflow 2): aieditor/preprod.py run(). For the
    whole narration it resolves the sites and, on the first ready app with an adapter, runs the full
    flow (readiness → shot list → assets → set dressing → dry run → gate) and writes
    preprod/{readiness,shotlist,assets,set_dressing,dryrun,expect,gate}.json — the director then plans
    only what the account can show, from produced assets (longedit.preprod_facts → planfit). If the
    module is missing the stage is SKIPPED.

    Contract the worker calls: preprod.run(job_dir, **kw) where kw is whichever of these the
    function's signature names (or all of them with **kwargs):
        req       request.json            edl       edl.json (the kept timeline)
        info      source.json             fps       source frame rate
        progress  progress(msg, frac)     cancelled ()->bool (raise/return early when True)
        log       log(line)               events    aieditor.events (api()/proc()/emit())
    It returns a note (str), or (note, usd), or {"note": ..., "usd": ...}; usd joins the job cost.
    It caches its own output in the job dir — it is called on every run of the creative edit."""
    d = job.d
    try:
        preprod = importlib.import_module("aieditor.preprod")    # optional, built separately
    except ModuleNotFoundError as exc:
        if exc.name not in ("aieditor.preprod", "preprod"):
            raise                                        # the module exists but a dependency is missing
        job.log("pre-production module not installed yet (aieditor/preprod.py) — stage skipped")
        job.stage("preprod", "skipped", "pre-production is not installed yet")
        return
    fn = getattr(preprod, "run", None)
    if not callable(fn):
        job.stage("preprod", "skipped", "aieditor/preprod.py has no run()")
        return
    offer = {"req": req, "edl": jload(d / "edl.json"), "info": info, "fps": fps,
             "progress": lambda m=None, f=None: job.progress(m, f), "cancelled": job.cancelled,
             "log": job.log, "events": events}
    try:
        params = inspect.signature(fn).parameters
        if not any(p.kind == p.VAR_KEYWORD for p in params.values()):
            offer = {k: v for k, v in offer.items() if k in params}
    except (TypeError, ValueError):
        pass
    job.stage("preprod", "running")
    job.progress("Pre-production…", 0)
    job.log("stage preprod start")
    try:
        out = fn(d, **offer)
    except InterruptedError:
        raise Cancelled()
    note, usd = out, 0.0
    if isinstance(out, tuple):
        note, usd = (list(out) + [0.0])[:2]
    elif isinstance(out, dict):
        note, usd = out.get("note"), out.get("usd") or 0.0
    if usd:
        job.st["cost_usd"] = round(job.st["cost_usd"] + float(usd), 4)
    note = (str(note) if note else "done") + (f", ${float(usd):.2f}" if usd else "")
    job.log(f"stage preprod done {note}")
    job.stage("preprod", "done", note)


def run_cut_path(job, action, req, fmt, sponsored, info, fps, words, sents, by_id, audio, step, rebuild):
    """Workflow 1 (cut an unedited narration): takes → review data → cut → sound check."""
    d = job.d

    # 5 takes
    # Jake 2026-10-09 ("cuts inside the narration that I didn't ask for"): a cut nobody
    # reviews (no_edit / factory) only removes retakes, false starts and whitelisted fillers
    policy = takes.policy_of(req)

    def do_takes():
        job.progress("Claude is picking the best take of every line…")
        feats = takes.features(sents, audio)
        kw = ({"policy": policy, "whitelist": takes.whitelist_of(req)}
              if policy != takes.POLICY_JAKE else {})
        plan, raw, meta = takes.pick(words, sents, feats, fmt, sponsored, req.get("script"), **kw)
        rb = meta.get("restored_by_policy") or {}
        if rb.get("sentences") or rb.get("words"):
            job.log(f"takes policy {policy}: put back {len(rb.get('sentences', []))} sentence(s) and "
                    f"{len(rb.get('words', []))} word(s) the model removed")
        jdump(d / "plan.raw.json", {"answer": raw, "meta": meta})
        jdump(d / "plan.json", plan)
        job.st["cost_usd"] = round(job.st["cost_usd"] + meta["usd"], 4)
        extra = ""
        if meta.get("restored_opening"):
            extra += f", {len(meta['restored_opening'])} line(s) kept by the 5:00 rule"
        if meta.get("seams_fixed"):
            extra += f", {meta['seams_fixed']} restart(s) across lines removed"
        return f"{len(plan['videos'])} video(s), ${meta['usd']:.2f}, {meta['seconds']}s{extra}"
    step("takes", do_takes, lambda: (d / "plan.json").exists())

    plan = jload(d / "plan.json")
    edit = jload(d / "plan.edit.json")
    if edit:
        plan = {**plan, "videos": takes.validate(edit, sents)["videos"]}

    # review data for the Lab page. "approved" (Jake approved the cut as it is, without
    # edits) survives a re-run: it is what lets a creative edit start from this cut
    approved = bool((jload(d / "review.json") or {}).get("approved"))
    jdump(d / "review.json", {
        "sentences": [{"s": n, "start": round(s[0]["s"], 2), "end": round(s[-1]["e"], 2),
                       "words": [{"i": w["i"], "w": w["w"]} for w in s]} for n, s in enumerate(sents)],
        "videos": plan["videos"],
        # why Claude dropped each sentence; anything not kept that has no reason here was
        # removed on the review screen
        "reasons": {str(r["s"]): r["why"] for r in jload(d / "plan.json")["removed"]},
        "notes": plan.get("notes", ""),
        "edited": bool(edit),
        **({"approved": True} if approved else {}),
    })

    # 6 cut
    def do_cut():
        # long-form: every rebuilt pause is exactly 0.35 s (Jake); shorts stay tighter
        nudges = (jload(d / "joins.edit.json") or {}).get("nudges") or {}
        built = [edl.build(v, sents, by_id, audio, fps, exact_gap=(fmt == "long"), nudges=nudges)
                 for v in plan["videos"]]
        jdump(d / "edl.json", {"fps": fps, "fps_num": info["fps_num"], "fps_den": info["fps_den"],
                               "width": info["width"], "height": info["height"], "videos": built})
        return ", ".join(f"{v['duration']:.0f}s/{v['cuts']} cuts" for v in built)
    step("cut", do_cut, lambda: (d / "edl.json").exists(), rerun=rebuild)

    # narration integrity (rubric D9): every spoken word the cut removed, and who approved it
    # (Jake's review, or the factory takes policy itself). A factory cut with an unapproved
    # removal fails here — before anything is built on it.
    e = jload(d / "edl.json")
    doc = wordiff.diff(words, sents, e["videos"], allowed=(jload(d / "plan.json") or {}).get("allowed"),
                       approved_by="review" if (edit or approved) else None)
    doc["policy"] = policy
    doc["join_issues"] = [x for v in e["videos"] for x in wordiff.check_joins(v)]
    jdump(d / "wordiff.json", doc)
    job.log(("warning: " if doc["unapproved"] else "") + wordiff.summary(doc))
    for x in doc["join_issues"]:
        job.log(f"warning: join overlap at {x['out']}s: {x['seconds']:.2f}s of audio plays twice ({x['text'][:80]})")
    if policy == takes.POLICY_FACTORY and doc["unapproved"]:
        raise RuntimeError(f"narration integrity: {doc['unapproved']} unapproved removal(s) in a factory cut "
                           f"(see wordiff.json) — nobody approved removing those words")

    # 7 sound check: the exact soundtrack of the current cut, no picture — minutes, not
    # the ~35 a 4K video preview takes (Jake: "can you preview without render?")
    def do_listen():
        e = jload(d / "edl.json")
        for k, v in enumerate(e["videos"], 1):
            job.progress(f"Sound check {k} of {len(e['videos'])}…", (k - 1) / len(e["videos"]))
            try:
                render.render(d, v, fps, f"listen-{k:02d}", render.listen_size(info["width"], info["height"]),
                              cancelled=job.cancelled,
                              room_tone_start=audio.room_tone(), audio_only=True)
            except render.RenderCancelled:
                raise Cancelled()
        for stale in d.glob("listen-*.mp4"):
            if int(stale.stem.split("-")[1]) > len(e["videos"]):
                stale.unlink()
        return f"{len(e['videos'])} sound check(s)"
    step("listen", do_listen, lambda: any(d.glob("listen-*.mp4")), rerun=rebuild)

    # 8 video preview: on the first run and when Jake presses Render video — never on
    # an edit (the previous video stays; the sound check is current)
    if rebuild and any(d.glob("preview-*.mp4")):
        job.stage("preview", "skipped", "older than the cut — press Render video")
        if fmt == "short":
            job.stage("graphics", "skipped", "older than the cut — press Render video")
            job.stage("compose", "skipped", "older than the cut — press Render video")
        return


def run_edit_part(job, action, req, fmt, sponsored, info, fps, audio, step):
    """Both workflows from here: graphics / screencasts, preview, compose."""
    d = job.d
    # 8a phase 2 (shorts): Claude plans the graphics on the cut's word ids (reused until
    # the cut changes), the camera framings follow from them (camera.py), and the
    # measured recipes render every graphic. Long-form graphics are not built yet.
    e = jload(d / "edl.json")
    if fmt == "short":
        edl_at = (d / "edl.json").stat().st_mtime

        def plan_fresh(k):
            f = d / f"graphics-{k:02d}.json"
            return f.exists() and f.stat().st_mtime >= edl_at

        def do_graphics():
            n_ev, usd = 0, 0.0
            for k, v in enumerate(e["videos"], 1):
                if not plan_fresh(k):
                    job.progress(f"Claude is planning the graphics of video {k} of {len(e['videos'])}…", (k - 1) / len(e["videos"]))
                    p, raw, meta = graphics.plan(v, fmt, sponsored)
                    jdump(d / f"graphics-{k:02d}.json", {"plan": p, "raw": raw, "meta": meta})
                    usd += meta["usd"]
                    for ev in p["dropped"]:
                        job.log(f"video {k}: graphic dropped ({ev['dropped']}): {json.dumps(ev.get('fields'))[:120]}")
                doc = jload(d / f"graphics-{k:02d}.json")
                evs = doc["plan"]["events"]
                doc["framings"] = camera.assign(v, evs, fps)          # one framing per piece
                jdump(d / f"graphics-{k:02d}.json", doc)
                n_ev += len(evs)
                try:
                    compose.render_events(d, k, evs, round(fps), scale=1, cancelled=job.cancelled,
                                          progress=lambda m, f: job.progress(f"Video {k}: {m}", f))
                except InterruptedError:
                    raise Cancelled()
            job.st["cost_usd"] = round(job.st["cost_usd"] + usd, 4)
            return f"{n_ev} graphics" + (f", ${usd:.2f}" if usd else "")
        step("graphics", do_graphics, rerun=True)
    else:
        # long-form: the full edit runs AFTER the preview (it is the edit's base) — below
        pass

    def framed(k, v):
        """the video with its camera framings (shorts) for render.render"""
        doc = jload(d / f"graphics-{k:02d}.json") if fmt == "short" else None
        if doc and doc.get("framings") and len(doc["framings"]) == len(v["pieces"]):
            v = {**v, "pieces": [{**p, "framing": f} for p, f in zip(v["pieces"], doc["framings"])]}
        return v

    def do_preview():
        e = jload(d / "edl.json")
        size = render.preview_size(info["width"], info["height"])
        # ⚠️ keep the previous previews until the new ones exist: deleting them first
        # left Jake with nothing to review for the whole re-render (render() writes
        # .part and swaps it in only when finished)
        (d / "roomtone.wav").unlink(missing_ok=True)
        for k, v in enumerate(e["videos"], 1):
            job.progress(f"Rendering preview {k} of {len(e['videos'])}…", (k - 1) / len(e["videos"]))
            try:
                n_v = len(e["videos"])
                render.render(d, framed(k, v), fps, f"preview-{k:02d}", size, cancelled=job.cancelled,
                              room_tone_start=audio.room_tone(), src_size=(info["width"], info["height"]),
                              progress=lambda f, k=k: job.progress(f"Rendering preview {k} of {n_v}…", (k - 1 + f) / n_v))
            except render.RenderCancelled:
                raise Cancelled()
        for stale in d.glob("preview-*.mp4"):                # videos that no longer exist
            if int(stale.stem.split("-")[1]) > len(e["videos"]):
                stale.unlink()
        return f"{len(e['videos'])} preview(s)"
    step("preview", do_preview, lambda: any(d.glob("preview-*.mp4")), rerun=(action == "render" or fmt == "short"))

    # 8c long-form: the FULL EDIT — screencasts (planned, recorded, camera-zoomed), facecam
    # bubble, overlays, A-roll camera, music bed (reference 2, kwysV2smgfY) → edit-NN.mp4
    if fmt == "long" and action in ("run", "render", "edit") and not req.get("no_edit"):
        e = jload(d / "edl.json")
        sites = req.get("sites") or []
        gate = jload(d / "preprod" / "gate.json")
        if gate is not None:
            # pre-production decided what can be screencast (given or derived from the narration, and ready)
            sites = [{"url": r["url"], "note": r.get("note", "")} for r in gate.get("sites", [])]
        elif not sites and workflow_of(req) == "creative":
            v0 = e["videos"][0]
            sites, u = sites_mod.resolve(d, req, {"title": v0.get("title", ""), "duration": v0["duration"],
                                                  "words": v0["words"]}, log=job.log)
            job.st["cost_usd"] = round(job.st["cost_usd"] + u, 4)
        if not sites:
            job.log("no screencast site for this edit — A-roll + overlays only")

        def do_graphics_long():
            notes, usd = [], 0.0
            for k, v in enumerate(e["videos"], 1):
                try:
                    note, u = longedit.plan_and_record(d, k, v, sites, sponsored, fps,
                                                       lambda m, f: job.progress(f"Video {k}: {m}", f),
                                                       job.cancelled, job.log)
                except InterruptedError:
                    raise Cancelled()
                notes.append(note)
                usd += u
            job.st["cost_usd"] = round(job.st["cost_usd"] + usd, 4)
            return "; ".join(notes) + (f", ${usd:.2f}" if usd else "")
        # Continue ("run") after a LATER stage failed reuses the recorded screencasts + overlays (a
        # compose error once cost a full re-record, 2026-10-09); "edit"/"render" always rebuild
        graphics_ready = lambda: (job.st["stages"].get("graphics", {}).get("state") == "done"
                                  and all((d / f"edit-{k:02d}" / "overlays.json").exists()
                                          for k in range(1, len(e["videos"]) + 1)))
        step("graphics", do_graphics_long, graphics_ready, rerun=(action != "run"))

        def do_compose_long():
            size = render.preview_size(info["width"], info["height"])
            w, h = (int(x) for x in size.split(":"))
            for k, v in enumerate(e["videos"], 1):
                try:
                    longedit.compose(d, k, f"preview-{k:02d}.mp4", fps, (w, h), job.cancelled,
                                     lambda m, f: job.progress(f"Video {k}: {m}", f), f"edit-{k:02d}")
                except InterruptedError:
                    raise Cancelled()
            return f"{len(e['videos'])} edited video(s)"
        step("compose", do_compose_long, rerun=True)
    elif fmt == "long":
        job.stage("graphics", "skipped", "press Build the edit (screencasts + graphics)")
        job.stage("compose", "skipped", "press Build the edit (screencasts + graphics)")

    # 8b shorts: the preview + graphics + captions + SFX → edit-NN.mp4
    if fmt == "short":
        def do_compose():
            size = render.preview_size(info["width"], info["height"])
            w, h = (int(x) for x in size.split(":"))
            for k, v in enumerate(e["videos"], 1):
                job.progress(f"Compositing video {k} of {len(e['videos'])} (graphics + captions + SFX)…", (k - 1) / len(e["videos"]))
                evs = jload(d / f"graphics-{k:02d}.json")["plan"]["events"]
                compose.captions(d, k, v, w, h)
                try:
                    compose.composite(d, k, evs, f"preview-{k:02d}.mp4", round(fps), f"edit-{k:02d}", cancelled=job.cancelled)
                except InterruptedError:
                    raise Cancelled()
            for stale in d.glob("edit-*.mp4"):
                if int(stale.stem.split("-")[1]) > len(e["videos"]):
                    stale.unlink()
            return f"{len(e['videos'])} edited video(s)"
        step("compose", do_compose, rerun=True)



def run_final(job, fmt):
    """The deliverable for shorts: the current cut at the SOURCE resolution, graphics
    rendered at 2× (2160×3840), captions sized for it, SFX — final-NN.mp4. Needs the
    graphics plan the preview used (anchored to word ids, so it matches the cut)."""
    d = job.d
    if fmt == "long":
        return run_final_long(job)
    info = jload(d / "source.json")
    fps = info["fps"]
    e = jload(d / "edl.json")
    w, h = info["width"], info["height"]
    scale = w / 1080
    audio = edl.Audio(d / "audio16k.wav")
    job.stage("final", "running")
    for k, v in enumerate(e["videos"], 1):
        gp = d / f"graphics-{k:02d}.json"
        if not gp.exists():
            raise RuntimeError(f"video {k} has no graphics plan yet — run the preview first")
        evs = jload(gp)["plan"]["events"]
        job.progress(f"Final {k} of {len(e['videos'])}: full-resolution cut…", (k - 1) / len(e["videos"]))
        try:
            doc = jload(gp)
            fv = v
            if doc.get("framings") and len(doc["framings"]) == len(v["pieces"]):
                fv = {**v, "pieces": [{**p, "framing": f} for p, f in zip(v["pieces"], doc["framings"])]}
            render.render(d, fv, fps, f"cutfull-{k:02d}", f"{w}:{h}", crf=14, preset="medium",
                          cancelled=job.cancelled, room_tone_start=audio.room_tone(), src_size=(w, h))
            job.progress(f"Final {k} of {len(e['videos'])}: graphics at {w}×{h}…")
            compose.render_events(d, k, evs, round(fps), scale=scale, cancelled=job.cancelled, tag="gfx4k",
                                  progress=lambda m, f: job.progress(f"Final {k}: {m}"))
            compose.captions(d, k, v, w, h, tag="captions4k")
            job.progress(f"Final {k} of {len(e['videos'])}: compositing…")
            compose.composite(d, k, evs, f"cutfull-{k:02d}.mp4", round(fps), f"final-{k:02d}", cancelled=job.cancelled,
                              tag="gfx4k", cap="captions4k", crf=16)
        except (render.RenderCancelled, InterruptedError):
            raise Cancelled()
        (d / f"cutfull-{k:02d}.mp4").unlink(missing_ok=True)
        shutil.rmtree(d / f"gfx4k-{k:02d}", ignore_errors=True)       # 4K PNGs are big: keep only the video
    job.stage("final", "done", f"{len(e['videos'])} final video(s)")


LONG_FINAL_MBPS = 45     # generous for 4K talking head at crf 16 (measured ~25–35)


def run_final_long(job):
    """The long-form deliverable: the current cut (Jake's take swaps, sentence edits and
    cut nudges included) at the SOURCE resolution — final-01.mp4. No graphics yet:
    long-form graphics are not built. Encoded once, piece by piece (render direct=True),
    so a 16-minute 4K cut needs ~2× its own size on disk, not ~40 GB."""
    d = job.d
    info = jload(d / "source.json")
    fps = info["fps"]
    e = jload(d / "edl.json")
    w, h = info["width"], info["height"]
    audio = edl.Audio(d / "audio16k.wav")
    secs = sum(p["frames"] for v in e["videos"] for p in v["pieces"]) / fps
    edited_any = (d / "edit-01" / "direct.json").exists()
    # cut + A-roll-camera copy + composite live at once for an edited final
    need = (4 if edited_any else 2) * secs * LONG_FINAL_MBPS / 8 * 1e6 + 2e9
    free = shutil.disk_usage(d).free
    if free < need:
        raise RuntimeError(f"not enough disk for the {secs / 60:.0f}-minute final: {free / 1e9:.1f} GB free, "
                           f"needs about {need / 1e9:.0f} GB")
    edited = all((d / f"edit-{k:02d}" / "direct.json").exists() for k in range(1, len(e["videos"]) + 1))
    job.stage("final", "running")
    for k, v in enumerate(e["videos"], 1):
        label = f"Final {k} of {len(e['videos'])} ({w}×{h})"
        if edited:
            # the cut at source resolution, then the whole edit on top of it at that size
            job.progress(f"{label}: the cut…", 0)
            try:
                render.render(d, v, fps, f"cutfull-{k:02d}", f"{w}:{h}", crf=14, preset="medium",
                              cancelled=job.cancelled, room_tone_start=audio.room_tone(), direct=True,
                              progress=lambda f: job.progress(f"{label}: the cut…", 0.3 * f))
                longedit.compose(d, k, f"cutfull-{k:02d}.mp4", fps, (w, h), job.cancelled,
                                 lambda m, f: job.progress(f"{label}: {m}", 0.3 + 0.7 * f), f"final-{k:02d}",
                                 face_src=f"preview-{k:02d}.mp4")
            except (render.RenderCancelled, InterruptedError):
                raise Cancelled()
            finally:
                (d / f"cutfull-{k:02d}.mp4").unlink(missing_ok=True)
            continue
        job.progress(f"{label}: encoding…", 0)
        try:
            render.render(d, v, fps, f"final-{k:02d}", f"{w}:{h}", crf=16, preset="medium",
                          cancelled=job.cancelled, room_tone_start=audio.room_tone(), direct=True,
                          progress=lambda f: job.progress(f"{label}: encoding…", f))
        except render.RenderCancelled:
            raise Cancelled()
    job.stage("final", "done", f"{len(e['videos'])} final video(s) at {w}×{h}")


QUICK = ("rebuild", "recut")     # Jake's edits: cut + sound check, minutes


def claim(skip=None):
    # Jake's own edits go first: a save waited 26 min behind a 4K test render (2026-10-05)
    # and looked lost. Then oldest first. skip(job_dir, action) leaves a request queued
    # (its job is on a factory server right now, or every factory slot is taken).
    def rank(q):
        try:
            action = (jload(q, {}) or {}).get("action", "run")
        except Exception:                                     # noqa: BLE001
            action = "run"
        return (0 if action in QUICK else 1, q.stat().st_mtime)
    best = None
    for q in sorted(config.JOBS.glob("*/queue.json"), key=rank):
        if skip and skip(q.parent, (jload(q, {}) or {}).get("action", "run")):
            continue
        best = q
        break
    if not best:
        return None, None
    req = jload(best, {}) or {}
    best.unlink(missing_ok=True)
    return Job(best.parent), req.get("action", "run")


def recover():
    """A job still 'running' at start-up was interrupted by a restart: say so."""
    for st in config.JOBS.glob("*/status.json"):
        s = jload(st, {})
        if s and s.get("state") == "running":
            s.update(state="interrupted", message="The worker restarted mid-job. Press Continue.",
                     updated_at=now())
            for name, v in s.get("stages", {}).items():
                if v.get("state") == "running":
                    v["state"] = "interrupted"
                    v["finished_at"] = now()
                    try:
                        with open(st.parent / "events.jsonl", "a") as f:
                            f.write(json.dumps({"t": round(now(), 3), "stage": name, "kind": "stage", "level": "warn",
                                                "state": "interrupted",
                                                "msg": f"■ {name} interrupted — the worker restarted mid-job"}) + "\n")
                    except OSError:
                        pass
            jdump(st, s)


def start(job, action):
    (job.d / "cancel").unlink(missing_ok=True)
    if action in ("rebuild", "recut"):
        for f in ("edl.json",):
            (job.d / f).unlink(missing_ok=True)
    job.save(state="running", message="Starting…", progress=0, error=None, action=action,
             started_at=now())


def execute(job, action):
    """One claimed request, start to finish, on THIS machine (the box, or a factory server)."""
    events.set_sink(job.event)
    events.set_sub(None)
    job.log(f"claimed action={action} (workflow: {workflow_of(job.req)})")
    try:
        run_job(job, action)
        job.save(state="done", message="Ready to review", progress=1, finished_at=now())
        events.emit("stage", "job finished — ready to review", stage="job")
    except Cancelled:
        job.log("cancelled")
        for name, s in list(job.st["stages"].items()):
            if s.get("state") == "running":
                job.stage(name, "interrupted", "cancelled")
        job.save(state="cancelled", message="Cancelled")
    except Exception as exc:                               # noqa: BLE001
        job.log("FAILED " + traceback.format_exc())       # filed under the stage that failed
        for name, s in list(job.st["stages"].items()):
            if s.get("state") == "running":
                job.stage(name, "failed", str(exc)[:200])
        job.save(state="failed", message=str(exc)[:500], error=str(exc)[:2000])
    finally:
        events.set_sink(None)
        (job.d / "cancel").unlink(missing_ok=True)
        for t in job.d.glob("tmp-*"):
            shutil.rmtree(t, ignore_errors=True)


def execute_cloud(job, action):
    """The same request on its own DigitalOcean droplet (aieditor/cloud.py). The droplet's
    worker writes status/events/log; this thread mirrors them back and always destroys it.
    If no server can be had, the job runs here instead (factory rule: route, don't fail)."""
    def note(msg, level="info"):
        # Written straight to the files, NOT through events' global sink: another job may own it.
        with open(job.d / "log.txt", "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + "factory: " + msg + "\n")
        with open(job.d / "events.jsonl", "a") as f:
            f.write(json.dumps({"t": round(now(), 3), "stage": "factory", "kind": "log", "level": level,
                                "msg": msg}, ensure_ascii=False) + "\n")
    try:
        # a Lab edit / an upload lives only on this box: put it in the job folder first, so it
        # travels with the folder (the server's "download" stage then just probes it)
        try:
            how = sources.materialise(job.d, job.req, config.JOBS)
            if how:
                note(f"source placed in the job folder ({'hard link, no copy' if how == 'link' else 'copied'})")
        except sources.SourceError as exc:
            note(f"source: {exc}", "error")
            j = Job(job.d)
            j.st["stages"].setdefault("download", {}).update(state="failed", note=str(exc)[:200], finished_at=now())
            j.save(state="failed", message=str(exc)[:500], error=str(exc)[:2000])
            return
        cloud.run_remote(job.d, action, note, job.cancelled)
    except Exception as exc:                               # noqa: BLE001
        note(f"factory server failed: {str(exc)[:300]}", "error")
        st = jload(job.d / "status.json", {}) or {}
        if st.get("state") == "running" and cloud.settings().get("fallback_local"):
            note("running this job on the main box instead")
            fresh = Job(job.d)
            fresh.save(state="running", message="Running on the main box (factory server unavailable)")
            with LOCAL:
                execute(fresh, action)
            return
        if st.get("state") == "running":
            Job(job.d).save(state="failed", message=f"factory server failed: {str(exc)[:300]}",
                            error=str(exc)[:2000])
    finally:
        (job.d / "cancel").unlink(missing_ok=True)


LOCAL = threading.Lock()            # one job at a time on THIS box


def main():
    def stop(*_):
        global STOP
        STOP = True
    signal.signal(signal.SIGTERM, stop)
    config.JOBS.mkdir(parents=True, exist_ok=True)
    recover()
    hb = config.WORK / "worker-heartbeat.json"

    def skip(d, action):
        if cloud.running(d.name):
            return True
        if not cloud.enabled_for(action, jload(d / "request.json", {})):
            return False
        # factory jobs wait (never drop to the main box) while every server slot is taken
        # or the rolling $20/24 h cap is reached
        return cloud.busy() >= cloud.settings()["max_parallel"] or cloud.over_daily_cap()

    while not STOP:
        jdump(hb, {"at": now(), "pid": os.getpid(), "factory_jobs": cloud.busy()})
        job, action = claim(skip)
        if not job:
            time.sleep(2)
            continue
        start(job, action)
        if cloud.enabled_for(action, job.req):
            # Heavy work goes to a per-job server; this loop keeps claiming.
            threading.Thread(target=execute_cloud, args=(job, action), daemon=True,
                             name=f"factory-{job.id}").start()
            time.sleep(1)
            continue
        cloud.runner(job.d, kind="box", state="running", action=action, started=now(), droplet=None,
                     usd=0.0, ended=None)
        with LOCAL:
            execute(job, action)
        cloud.runner(job.d, state="done", ended=now())


def once(job_id, action):
    """`aieditor-worker --once <job id> <action>` — what a factory server runs."""
    job = Job(config.JOBS / job_id)
    job.save(state="running", action=action, host=os.uname().nodename)
    execute(job, action)
    return 0 if job.st.get("state") == "done" else 1


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "--once":
        sys.exit(once(sys.argv[2], sys.argv[3]))
    main()
