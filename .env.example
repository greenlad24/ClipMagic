# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── The one that is not optional ─────────────────────────────────────────────
# Gemini does double duty: Nano Banana / Nano Banana Pro for every image step
# (portrait, character sheet, room placement) AND Gemini TTS for the narration
# voice. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Render engines — you need at least ONE ───────────────────────────────────
# Two different classes of model, and the difference is the whole cost story:
#
#   GENERATIVE (Seedance 2.5): portrait + narration -> a generated presenter.
#     segmind  720p ~$14.30/finished min · 480p ~$6.40
#     kie      720p ~$18.90/finished min
#
#   LIPSYNC (InfiniteTalk): drives the actual portrait from the audio. A
#   different, far cheaper problem — and the reason this tool exists.
#     kie / wavespeed  720p ~$3.60/finished min
#     self-hosted      ~$0.30/finished min (see below)
#
# Segmind is the default because it is the key that was set first, not because
# it is the cheapest. If cost per minute matters, put a key in kie.ai and pick
# an InfiniteTalk provider in the UI.
SEGMIND_API_KEY=
KIE_API_KEY=
WAVESPEED_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# ElevenLabs: better voice cloning than Gemini TTS, at a price. Leave blank to
# use Gemini's voices, which are free with the key above.
ELEVENLABS_API_KEY=

# A self-hosted InfiniteTalk worker on a rented GPU — by far the cheapest per
# minute, but the break-even against a hosted API is around 150 finished
# minutes/month. Below that the GPU does not pay for its own upkeep.
INFINITETALK_SELFHOST_URL=
INFINITETALK_SELFHOST_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
# REQUIRED BEFORE ANY VIDEO CAN RENDER. The providers fetch the portrait and the
# narration from URLs built off this origin using their own HTTP client, so it
# must be publicly reachable — they cannot reach localhost. For local work,
# expose the port with a tunnel (cloudflared / ngrok) and put that hostname
# here. Portraits and voices generate fine without it; only rendering breaks.
PUBLIC_BASE_URL=

PORT=8080
HOST=0.0.0.0

# Where personas, audio, videos and the SQLite database live. Defaults to
# ./data at the repo root.
# DATA_DIR=/absolute/path/to/data

# ffmpeg and ffprobe must be on PATH (used to stitch segments and convert the
# PCM that Gemini TTS returns into mp3). Override if they live elsewhere.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# How long a file stays readable in the public provider drop. Default 24h.
# PUBLIC_ASSET_TTL_MS=86400000
